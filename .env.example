# ─────────────────────────────────────────────────────────────
# Autonomous Data Entry Platform — environment template
# Copy to .env and fill in. Never commit .env.
# ─────────────────────────────────────────────────────────────

# ── Supabase (control plane + tenant schemas + storage) ──────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=documents

# Server-side only. Direct Postgres connection used by the engine and migrations.
DATABASE_URL=

# ── WorkOS (user + organisation authentication) ─────────────
# Section 12c: each WorkOS organisation maps to one tenant and one Postgres schema.
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_COOKIE_PASSWORD=
WORKOS_REDIRECT_URI=http://localhost:3000/api/auth/callback
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/api/auth/callback
# Dev-only escape hatch: when WorkOS keys are unset the web app runs with a
# synthetic session for a seeded tenant so the queue can be exercised locally.
ALLOW_DEV_SESSION=true

# ── Engine (FastAPI + Pydantic AI) ──────────────────────────
ENGINE_ENV=development
ENGINE_API_URL=http://127.0.0.1:8088
# Shared secret used by the web app when calling the engine server-to-server.
ENGINE_SERVICE_TOKEN=dev-engine-service-token
# Set of service credentials for calling Ygudy products (section 8).
ENGINE_PRODUCT_CREDENTIALS={"counsel":"dev-counsel-token","ca-product":"dev-ca-token","admissions":"dev-admissions-token"}

# Model provider for the extraction/classification agents. Pydantic AI.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://freebuff.com/api/v1/paid
EXTRACTION_MODEL=gpt-4o-mini
VISION_MODEL=gpt-4o

# ── Inngest (durable workflows) ─────────────────────────────
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
INNGEST_DEV=1

# ── Langfuse (traces, cost, accuracy) ───────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ── GSTN / GST Suvidha Provider (Appendix B) ────────────────
# Official GSTN source through an empanelled GSP. Third-party verification
# APIs are for prototypes only and are not the production source.
GSP_PROVIDER=
GSP_CLIENT_ID=
GSP_CLIENT_SECRET=
GSP_BASE_URL=
GSP_LOOKUP_TIMEOUT_SECONDS=8
# When true, GSTIN calls are served from the local fixture stub (prototype only).
GSP_USE_FIXTURE=true

# ── Bridge agent (Appendix E) ───────────────────────────────
# Ed25519 keypair used to sign/verify post commands. Generate with
#   python -m bridge_agent.cli keygen
AGENT_COMMAND_SIGNING_KEY=
AGENT_COMMAND_PUBLIC_KEY=
AGENT_COMMAND_TTL_SECONDS=900
AGENT_HEARTBEAT_GRACE_SECONDS=300

# ── Autonomy thresholds (section 12a — keep as settings) ────
DEFAULT_CONFIDENCE_THRESHOLD=0.93
DEFAULT_AUTOPOST_VALUE_CAP=50000
DEFAULT_DAILY_AUTOPOST_CAP=200
DEFAULT_ERROR_RATE_LIMIT=0.005
